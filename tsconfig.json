{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "claude-code": ["./plugins/cc-jev-pruner/types/claude-code.d.ts"]
    }
  },
  "include": ["plugins/*/src", "plugins/*/hooks", "scripts", "plugins/cc-jev-pruner/types"]
}
